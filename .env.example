VITE_CLOUDINARY_CLOUD_NAME=otexvxtd
CLOUDINARY_CLOUD_NAME=otexvxtd
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional shared preset fallback. Use per-track presets below when each CV has its own unsigned preset.
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_FLUTTER_UPLOAD_PRESET=Flutter-cv
VITE_CLOUDINARY_FRONTEND_UPLOAD_PRESET=front-end-cv

VITE_ADMIN_DASHBOARD_PATH=ahmed_dashboard
VITE_ADMIN_PIN=change-this-pin-in-vercel
ADMIN_PIN=change-this-pin-in-vercel

# Analytics (optional — dashboard shows demo data until these are set).
# The Upstash integration injects KV_REST_API_URL / KV_REST_API_TOKEN automatically.
# For local dev, copy them from Vercel → Project → Settings → Environment Variables
# (or run `vercel env pull`) into your local .env — never commit real secrets:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
